{
  "name": "kryzect-official-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "lint": "oxlint --deny-warnings",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write src scripts tests package.json vercel.json vite.config.js index.html",
    "format:check": "prettier --check src scripts tests package.json vercel.json vite.config.js index.html",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
