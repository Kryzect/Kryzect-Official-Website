# Local development: copy this file to .env. Never commit real keys.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Override these if your account uses a different supported structured-output model.
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ASSISTANT_ENABLED=true
# Strict by default; some free routes are unavailable under this privacy filter.
ASSISTANT_OPENROUTER_DATA_COLLECTION=deny

# Required on Vercel: shared atomic rate limits and daily request budget.
# Local development/preview can use an in-memory limiter without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ASSISTANT_DAILY_LIMIT=300
ASSISTANT_IP_MINUTE_LIMIT=10
ASSISTANT_SESSION_LIMIT=30

# Optional: comma-separated additional exact HTTPS origins for a custom domain.
ASSISTANT_ALLOWED_ORIGINS=
